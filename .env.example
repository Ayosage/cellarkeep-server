# Copy to .env and fill in real values before running docker compose --profile prod up.

# Postgres connection string for the app database.
DATABASE_URL=postgres://cellarkeep:cellarkeep@db:5432/cellarkeep

# Random secret used to sign session cookies. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# The web client's origin, used for CORS and cookie settings.
CLIENT_ORIGIN=http://localhost:3000
